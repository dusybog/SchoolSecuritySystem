@using System.Security.Principal

<ul class="navbar-nav align-items-center gap-3">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item">
            <span class="navbar-text text-dark mb-0">Hello @User.Identity?.Name!</span>
        </li>
        <li class="nav-item">
            <a class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm" asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="SignOut">登出</a>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm" asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="SignIn">Sign in</a>
        </li>
    }
</ul>