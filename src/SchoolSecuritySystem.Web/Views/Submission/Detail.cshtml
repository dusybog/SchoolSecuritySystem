@using SchoolSecuritySystem.Core.Constants
@{
    ViewData["Title"] = "通報單詳細內容";
    var submissionId = ViewBag.SubmissionId;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    /* ==========================================
        橫向流程圖 (Stepper) 專屬樣式
    ========================================= */
    .stepper-wrapper { display: flex; justify-content: space-between; position: relative; padding: 0 20px; z-index: 1; }
    .stepper-item { position: relative; display: flex; flex-direction: column; align-items: center; flex: 1; }
    .stepper-item::before { content: ''; position: absolute; top: 18px; left: -50%; width: 100%; height: 4px; background-color: #e9ecef; z-index: 1; }
    .stepper-item:first-child::before { display: none; }
    .step-counter { position: relative; z-index: 2; width: 32px; height: 32px; border-radius: 50%; background-color: #e9ecef; color: white; display: flex; justify-content: center; align-items: center; font-weight: bold; margin-bottom: 8px; border: 4px solid #ffffff; box-sizing: content-box; transition: all 0.3s ease; }
    .step-name { font-size: 14px; color: #6c757d; font-weight: 500; }
    .stepper-item.completed .step-counter { background-color: #198754; color: white; }
    .stepper-item.completed::before { background-color: #198754; }
    .stepper-item.completed .step-name { color: #198754; font-weight: bold; }
    .stepper-item.active .step-counter { background-color: #dc3545; color: white; box-shadow: 0 0 0 4px rgba(220, 53, 69, 0.2); }
    .stepper-item.active::before { background-color: #198754; }
    .stepper-item.active .step-name { font-weight: bold; color: #dc3545; }
    .stepper-item.rejected .step-counter { background-color: #dc3545; color: white; box-shadow: 0 0 0 4px rgba(220, 53, 69, 0.2); }
    .stepper-item.rejected::before { background-color: #198754; }
    .stepper-item.rejected .step-name { font-weight: bold; color: #dc3545; }

    /* Modal 選擇系所專屬樣式 */
    .dept-card { transition: all 0.2s ease; border: 1px solid transparent; background-color: #ffffff; }
    .dept-card:hover { transform: translateY(-2px); box-shadow: 0 4px 8px rgba(0,0,0,0.08) !important; }
    .dept-checkbox:checked + .dept-card { background-color: #f0f7ff !important; border-color: #0d6efd !important; }
    .dept-checkbox:checked + .dept-card .dept-name { color: #0d6efd !important; font-weight: 800 !important; }
    .dept-checkbox:checked + .dept-card .check-icon { opacity: 1 !important; transform: scale(1) !important; }
    .check-icon { opacity: 0; transform: scale(0.5); transition: all 0.2s ease; }
</style>

<div class="container-fluid mt-4 mb-5">
    
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border border-secondary-subtle">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                        <h5 class="fw-bold text-dark mb-0">🔄 流程圖與處理歷程</h5>
                        <button id="btn-toggle-history" class="btn btn-sm btn-outline-primary fw-bold">
                            📊 顯示詳細歷程
                        </button>
                    </div>
                    <div id="workflow-flowchart" class="mb-4 mt-3 px-2 text-center">
                        <span class="text-muted">載入流程圖中...</span>
                    </div>
                    <div id="history-datagrid-container" class="mt-4" style="display: none;"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3 mb-3 mb-md-0">
            <div class="card shadow-sm h-100 border border-secondary-subtle">
                <div class="card-header bg-light fw-bold border-bottom pt-3">📑 版本選擇</div>
                <div class="list-group list-group-flush" id="version-list">
                    <div class="text-center p-3 text-muted small spinner-border spinner-border-sm mx-auto mt-2"></div>
                </div>
            </div>
        </div>
        <div class="col-md-9">
            <div class="card shadow-sm h-100 border border-secondary-subtle">
                <div class="card-header bg-light border-bottom d-flex justify-content-between align-items-center">
                    <span class="fw-bold fs-5 text-dark">📝 表單內容</span>
                    <span id="current-version-badge" class="badge bg-secondary fs-6">載入中...</span>
                </div>
                <div class="card-body" id="form-container"></div>
            </div>
        </div>
    </div>

    @if (User.IsInRole(AppRoles.CenterOfficer) || User.IsInRole(AppRoles.CenterDirector) || User.IsInRole(AppRoles.DepartmentOfficer))
    {
        <div class="row mt-2" id="audit-action-panel" style="display: none;">
            <div class="col-12">
                <div class="card shadow border-warning bg-warning bg-opacity-10">
                    <div class="card-header bg-warning text-dark fw-bold">✍️ 審核 / 修改區塊</div>
                    <div class="card-body">
                        <form id="audit-form">
                            <div class="mb-3">
                                <label class="form-label fw-bold text-dark">審核意見</label>
                                <textarea class="form-control border-warning shadow-sm" id="audit-comment" rows="3" placeholder="請填寫審核或修改之具體意見..."></textarea>
                            </div>
                            <div class="d-flex justify-content-end gap-3">
                                <button type="button" class="btn btn-success fw-bold px-4" id="btn-approve">✅ 儲存修改並核准</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (User.IsInRole(AppRoles.CenterOfficer) || User.IsInRole(AppRoles.CenterDirector))
    {
        <div class="row mt-4" id="dispatch-management-panel" style="display: none;">
            <div class="col-12">
                <div class="card shadow-sm border border-info">
                    <div class="card-header bg-info text-white fw-bold d-flex justify-content-between align-items-center">
                        <span class="fs-5">📤 派發與寄信管理</span>
                        <button id="btn-create-dispatch" class="btn btn-sm btn-light text-info fw-bold shadow-sm">
                            <i class="bi bi-plus-lg"></i> 新增空白派發單
                        </button>
                    </div>
                    <div class="card-body bg-light">
                        <div id="dispatch-cards-container">
                            <div class="text-center text-muted py-3">載入中...</div>
                        </div>
                    </div>
                    <div id="close-footer-section" class="card-footer bg-white text-center py-4 border-top" style="display: none;">
                        <button id="btn-close-submission" class="btn btn-lg btn-danger fw-bold shadow-sm px-5">
                            <i class="bi bi-check-circle-fill"></i> 確認結案
                        </button>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="modal fade" id="deptSelectionModal" tabindex="-1" aria-labelledby="deptSelectionModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
                <div class="modal-content border-0 shadow-lg">
                    <div class="modal-header bg-primary text-white border-0">
                        <h5 class="modal-title fw-bold" id="deptSelectionModalLabel"><i class="bi bi-building me-1"></i> 選擇要寄送的系所(選定後無法修改)</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="bg-light p-3 border-bottom sticky-top" style="z-index: 10;">
                        <div class="input-group shadow-sm mb-2">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                            <input type="text" id="deptSearchInput" class="form-control border-start-0 ps-0" placeholder="搜尋系所名稱...">
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="small fw-bold text-secondary">已選取: <span id="selectedDeptCount" class="text-primary fs-5">0</span> 個系所</span>
                            <div>
                                <button type="button" class="btn btn-sm btn-outline-secondary fw-bold" id="btn-select-all">全選顯示項目</button>
                                <button type="button" class="btn btn-sm btn-outline-danger fw-bold ms-1" id="btn-clear-all">清除</button>
                            </div>
                        </div>
                    </div>
                    <div class="modal-body bg-light pt-3 pb-4" id="deptSelectionModalBody"></div>
                    <div class="modal-footer bg-white border-top-0">
                        <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">取消</button>
                        <button type="button" class="btn btn-primary fw-bold px-4" id="btn-confirm-add-depts">確認新增</button>
                    </div>
                </div>
            </div>
        </div>
    }

</div>

<script type="module">
    import { renderForm, renderReadOnly } from '/js/FormRenderer.js';
    import { bindEventCategoryLogic } from '/js/EventCategoryHandler.js';
    import { DataGrid } from '/js/DataGrid.js';
    
    // 只有能修改表單的人才需要載入 FormParser，節省資源並防範探測
    @if (!User.IsInRole(AppRoles.GeneralUser))
    {
        <text>import { extractFormData } from '/js/FormParser.js';</text>
    }

    const currentSubmissionId = '@submissionId';
    const appState = {
    status: 0,
    versions: [],
    workflows: [],
    dispatches: [],
    latestVersionId: null,
    currentSelectedVersionId: null,
    originalFormData: null,
    targetDispatchIdForDepts: null
    };
    
    let historyGrid;

    // ==========================================
    // 🛡️ 共用基礎邏輯 (所有角色皆會載入)
    // ==========================================
    async function fetchInitialData() {
    try {
    const res = await fetch(`/api/submissions/${currentSubmissionId}`);
    if (!res.ok) throw new Error("無法取得通報單資料");

    const data = await res.json();
    appState.status = data.status;
    appState.latestVersionId = data.latestVersion ? `v${data.latestVersion}` : null;
    appState.versions = (data.versions || []).map(v => ({
    v_Id: v.v_Id,
    createdAt: v.createdAt,
    createdBy: v.createdBy
    }));

    appState.workflows = (data.workflows || []).map(w => ({
    createdAt: w.createdAt,
    createdBy: w.createdBy,
    comment: w.comment
    }));
    appState.dispatches = (data.dispatches || []).map(d => ({
    id: d.id, status: d.status, directorSign: d.directorSign, directorSignAt: d.directorSignAt,
    officerSign: d.officerSign, officerSignAt: d.officerSignAt, selects: d.selects || [], logs: d.logs || []
    }));
    } catch (error) {
    console.error("載入失敗:", error);
    const versionList = document.getElementById('version-list');
    if (versionList) versionList.innerHTML = '<div class="text-danger text-center p-3 small">⚠️ 無法載入資料，請重新整理網頁。</div>';
    }
    }

    async function fetchAndRenderVersion(v_id) {
    try {
    appState.currentSelectedVersionId = v_id;
    updateVersionListUI(v_id);
                
    const isLatest = (v_id === appState.latestVersionId);
    const badge = document.getElementById('current-version-badge');
    badge.textContent = isLatest ? `目前檢視：${v_id} (最新版)` : `目前檢視：${v_id} (歷史唯讀)`;
    badge.className = isLatest ? 'badge bg-success' : 'badge bg-secondary';
    document.getElementById('form-container').innerHTML = '<div class="spinner-border text-primary"></div>';

    const versionNumber = parseInt(v_id.replace('v', ''), 10);
    const res = await fetch(`/api/submissions/${currentSubmissionId}/versions/${versionNumber}`);
    const versionData = await res.json();
            
    if(isLatest) appState.originalFormData = JSON.parse(JSON.stringify(versionData));
            
    renderFormBasedOnPermissions(versionData, isLatest);
    } catch (error) {
    console.error(`載入版本失敗:`, error);
    }
    }

    function renderFormBasedOnPermissions(versionData, isLatest) {
    let canEdit = false;

    // 依據角色與表單狀態，判斷是否開放編輯
    @if (User.IsInRole(AppRoles.DepartmentOfficer))
    {
        <text>if (appState.status === 0) canEdit = true;</text>
    }
    @if (User.IsInRole(AppRoles.CenterOfficer) || User.IsInRole(AppRoles.CenterDirector))
    {
        <text>if (appState.status === 10) canEdit = true;</text>
    }

    const auditPanel = document.getElementById('audit-action-panel');
    if (canEdit && isLatest) {
    renderForm('form-container', versionData);
    bindEventCategoryLogic(versionData.basic);
    if (auditPanel) auditPanel.style.display = 'block';
    } else {
    renderReadOnly('form-container', versionData);
    bindEventCategoryLogic(versionData.basic);
    if (auditPanel) auditPanel.style.display = 'none';
    }
    }

    function renderFlowchart() {
    const container = document.getElementById('workflow-flowchart');
    const currentStatusCode = appState.status;
    const steps = [
    { code: 0, label: "建立表單" }, { code: 10, label: "系所承辦審核" },
    { code: 20, label: "校安中心審核" }, { code: 30, label: "結案" }
    ];
    let html = '<div class="stepper-wrapper w-100">';
    let hasFoundFirstGreater = false;
    steps.forEach((step, index) => {
    let statusClass = '';
    if (step.code <= currentStatusCode) { statusClass = 'completed'; }
    else if (step.code > currentStatusCode && !hasFoundFirstGreater) { statusClass = 'rejected'; hasFoundFirstGreater = true; }
    html += `<div class="stepper-item ${statusClass}"><div class="step-counter">${index + 1}</div><div class="step-name">${step.label}</div></div>`;
    });
    html += '</div>';
    container.innerHTML = html;
    }

    function renderVersionList() {
    const list = document.getElementById('version-list');
    list.innerHTML = '';
    
    if (!appState.versions || appState.versions.length === 0) {
    list.innerHTML = '<div class="text-center p-4 text-muted small">尚無版本紀錄</div>';
    return;
    }
    
    appState.versions.forEach((v, index) => {
    const isLatest = (index === 0);
    const a = document.createElement('a');
    a.href = '#';
    a.className = `list-group-item list-group-item-action border-0 border-bottom border-secondary-subtle version-item`;
        
    a.dataset.vid = v.v_Id;
    const displayTime = v.createdAt ? v.createdAt.replace('T', ' ').substring(0, 19) : '未知時間';

    a.innerHTML = `
    <div class="d-flex justify-content-between align-items-center">
    <span class="fw-bold title-text text-primary">版本 ${v.v_Id}</span>
    ${isLatest ? '<span class="badge bg-danger rounded-pill shadow-sm">最新</span>' : ''}
    </div>
    <div class="small text-muted mt-1"><i class="bi bi-clock"></i> ${displayTime}</div>`;
            
    a.addEventListener('click', (e) => {
    e.preventDefault();
    fetchAndRenderVersion(v.v_Id);
    });
        
    list.appendChild(a);
    });
    }

    function updateVersionListUI(selected_vid) {
    document.querySelectorAll('.version-item').forEach(el => {
    el.classList.remove('active', 'bg-primary', 'text-white');
    const titleSpan = el.querySelector('.title-text');
    titleSpan.classList.replace('text-white', 'text-primary');
    if (el.dataset.vid === selected_vid) {
    el.classList.add('active', 'bg-primary', 'text-white');
    titleSpan.classList.replace('text-primary', 'text-white');
    }
    });
    }

    function initHistoryDataGrid() {
    const versionLogs = appState.versions.map(v => ({
    type: '內容異動',
    time: v.createdAt,
    actor: v.createdBy || '-',
    desc: `儲存版本 ${v.v_Id || ''}`
    }));

    const workflowLogs = appState.workflows.map(w => ({
    type: '簽核流程',
    time: w.createdAt,
    actor: w.createdBy || '-',
    desc: w.comment || '-'
    }));
    
    const combinedHistory = [...workflowLogs, ...versionLogs].sort((a, b) => new Date(b.time) - new Date(a.time));
    
    historyGrid = new DataGrid({
    containerId: 'history-datagrid-container',
    pageSize: 9999,
    columnMapping: {
    time: { label: '發生時間', formatter: (val) => val ? val.replace('T', ' ') : '-' },
    type: { label: '紀錄類型', formatter: (val) => `<span class="badge bg-${val.includes('簽核') ? 'success' : 'info text-dark'}">${val}</span>` },
    actor: '操作人員',
    desc: '備註'
    }
    });
    historyGrid.setData(combinedHistory);

    const btnToggle = document.getElementById('btn-toggle-history');
    const gridContainer = document.getElementById('history-datagrid-container');
    btnToggle.addEventListener('click', () => {
    const isHidden = gridContainer.style.display === 'none';
    gridContainer.style.display = isHidden ? 'block' : 'none';
    btnToggle.innerHTML = isHidden ? '📊 隱藏詳細歷程' : '📊 顯示詳細歷程';
    btnToggle.className = isHidden ? 'btn btn-sm btn-secondary fw-bold' : 'btn btn-sm btn-outline-primary fw-bold';
    });
    }

    function isDeepEqual(obj1, obj2) {
    if (obj1 === obj2) return true;
    if (typeof obj1 !== 'object' || obj1 === null || typeof obj2 !== 'object' || obj2 === null) return false;
    let keys1 = Object.keys(obj1), keys2 = Object.keys(obj2);
    if (keys1.length !== keys2.length) return false;
    for (let key of keys1) if (!keys2.includes(key) || !isDeepEqual(obj1[key], obj2[key])) return false;
    return true;
    }

    async function getErrorMessage(res) {
    try { const errData = await res.json(); return errData.message || errData.error || `伺服器錯誤 (${res.status})`; }
    catch { return `伺服器錯誤 (${res.status})`; }
    }


    // ==========================================
    // 🛡️ 審核與修改邏輯 (僅特定角色載入)
    // ==========================================
    @if (User.IsInRole(AppRoles.DepartmentOfficer) || User.IsInRole(AppRoles.CenterOfficer) || User.IsInRole(AppRoles.CenterDirector))
    {
        <text>
            function bindAuditEvents() {
            const btnApprove = document.getElementById('btn-approve');
            if (!btnApprove) return;

            btnApprove.addEventListener('click', async () => {
            if (!confirm('確定要儲存修改並核准此通報單嗎？')) return;
            const formData = extractFormData();
            if (!formData) return;

            const isDataChanged = !isDeepEqual(appState.originalFormData, formData);
            const comment = document.getElementById('audit-comment').value.trim();
            const payload = { action: 'Approve', comment: comment };
            if (isDataChanged) payload.formData = formData;

            const originalText = btnApprove.innerHTML;
            btnApprove.disabled = true;
            btnApprove.innerHTML = '<span class="spinner-border spinner-border-sm"></span> 處理中...';

            try {
            const res = await fetch(`/api/submissions/${currentSubmissionId}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
            });
            if (!res.ok) throw new Error(await getErrorMessage(res));
            alert('✅ 審核與更新成功！');
            window.location.reload();
            } catch (error) {
            alert(`❌ 審核失敗：\n${error.message}`);
            btnApprove.disabled = false;
            btnApprove.innerHTML = originalText;
            }
            });
            }
        </text>
    }


    // ==========================================
    // 🛡️ 派發管理與結案邏輯 (僅校安中心載入)
    // ==========================================
    @if (User.IsInRole(AppRoles.CenterOfficer) || User.IsInRole(AppRoles.CenterDirector))
    {
        <text>
            let deptModalInstance = null;

            function initDispatchSection() {
            // 1. 載入卡片資料
            loadDispatchCards();

            // 2. 綁定「新增空白派發單」按鈕事件
            const btnCreateDispatch = document.getElementById('btn-create-dispatch');
            if (btnCreateDispatch) {
            btnCreateDispatch.addEventListener('click', async () => {
            // 🌟 實作：新增派發單 API 呼叫 [POST] HOST/api/submissions/{submissionId}/dispatches
            if (!confirm('確定要新增一張空白派發單嗎？')) return;
                    
            const originalText = btnCreateDispatch.innerHTML;
            btnCreateDispatch.disabled = true;
            btnCreateDispatch.innerHTML = '<span class="spinner-border spinner-border-sm"></span> 處理中...';

            try {
            const res = await fetch(`/api/submissions/${currentSubmissionId}/dispatches`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
            });
                        
            if (!res.ok) throw new Error(await getErrorMessage(res));
                        
            alert('✅ 成功建立空白派發單！');
            await loadDispatchCards(); // 建立成功後重新載入卡片
            } catch (error) {
            alert(`❌ 建立失敗：\n${error.message}`);
            } finally {
            btnCreateDispatch.disabled = false;
            btnCreateDispatch.innerHTML = originalText;
            }
            });
            }

            // 3. 綁定「確認選擇系所」按鈕事件
            const btnConfirmAddDepts = document.getElementById('btn-confirm-add-depts');
            if (btnConfirmAddDepts) {
            btnConfirmAddDepts.addEventListener('click', async (e) => {
            if (!appState.targetDispatchIdForDepts) return;
            const selectedCheckboxes = document.querySelectorAll('.dept-checkbox:checked');
            const deptIds = Array.from(selectedCheckboxes).map(cb => parseInt(cb.value));
            if (deptIds.length === 0) return alert('請至少勾選一個系所！');
                    
            const btn = e.target;
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> 處理中...';
            try {
            const res = await fetch(`/api/submissions/${currentSubmissionId}/dispatches/${appState.targetDispatchIdForDepts}/select`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(deptIds)
            });
            if (!res.ok) throw new Error(await getErrorMessage(res));
            alert('✅ 系所選擇成功！');
            deptModalInstance.hide();
            await loadDispatchCards(); // 更新卡片，此時才會去呼叫 bindDispatchCardEvents()
            } catch (error) {
            alert(`❌ 選擇系所失敗：\n${error.message}`);
            } finally {
            btn.disabled = false;
            btn.innerHTML = originalText;
            appState.targetDispatchIdForDepts = null;
            }
            });
            }
            }

            async function loadDispatchCards() {
            const container = document.getElementById('dispatch-cards-container');
            if (!container) return;
            container.innerHTML = '<div class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm"></span> 載入派發單中...</div>';
            try {
            const res = await fetch(`/api/submissions/${currentSubmissionId}/dispatches`);
            if (!res.ok) throw new Error(await getErrorMessage(res));
                
            const dispatches = await res.json();
            appState.dispatches = dispatches;
                
            if (dispatches.length === 0) {
            container.innerHTML = '<div class="alert alert-secondary text-center mt-3">尚未建立任何派發單。請點擊右上方按鈕新增。</div>';
            return;
            }
                
            // 1. 將包含外層 DOM (尚未有 Grid 內容) 的字串塞入頁面
            container.innerHTML = dispatches.map(d => generateDispatchCard(d)).join('');
                
            // 2. 在 DOM 存在後，綁定 DataGrid 渲染資料
            initDispatchDataGrids(dispatches);
                
            // 3. 綁定按鈕事件 (寄信、刪除等)
            bindDispatchCardEvents();
                
            } catch (err) {
            container.innerHTML = `<div class="alert alert-danger mt-3">載入失敗：${err.message}</div>`;
            }
            }

            function generateDispatchCard(d) {
            const hasDepartments = d.selects && d.selects.length > 0;
            const isSent = d.status === 20 || d.status === 10;
            const isFullySigned = !!(d.directorSign && d.officerSign);
            
            // 判斷當前通報單是否已結案 (狀態碼 30)
            const isSubmissionClosed = appState.status === 30;

            let primaryActionBtn = '';
            
            if (!hasDepartments) {
            // 若結案，則不顯示新增系所按鈕
            if (!isSubmissionClosed) {
            primaryActionBtn = `<button class="btn btn-outline-primary fw-bold btn-add-depts"><i class="bi bi-plus-circle"></i> 新增寄送系所</button>`;
            }
            } else if (isFullySigned){
            const previewBtn = `<button class="btn btn-outline-secondary fw-bold btn-preview-dispatch me-2"><i class="bi bi-file-earmark-pdf"></i> 預覽附件</button>`;
            let sendBtn = '';
                
            // 若結案，不渲染寄信按鈕，只保留預覽
            if (!isSubmissionClosed) {
            if (d.status === 20) {
            sendBtn = `<button class="btn btn-secondary fw-bold btn-send-emails" disabled data-signed="${isFullySigned}"><i class="bi bi-check-circle-fill"></i> 寄送已完成</button>`;
            } else if (d.status === 10) {
            sendBtn = `<button class="btn btn-secondary fw-bold btn-send-emails" disabled data-signed="${isFullySigned}"><i class="bi bi-hourglass-split"></i> 寄信處理中</button>`;
            } else if (d.status === 21) {
            sendBtn = `<button class="btn btn-warning text-dark fw-bold btn-send-emails" data-signed="${isFullySigned}"><i class="bi bi-arrow-clockwise"></i> 寄送失敗，點此重試</button>`;
            } else {
            sendBtn = `<button class="btn btn-success fw-bold btn-send-emails" data-signed="${isFullySigned}"><i class="bi bi-send-fill"></i> 確認寄出通知信</button>`;
            }
            }
                
            primaryActionBtn = previewBtn + sendBtn;
            }

            let tableHtml = '';
            if (hasDepartments) {
            tableHtml = `<div id="dispatch-depts-grid-${d.id}" class="mt-3"></div>`;
            } else {
            tableHtml = `<div class="alert alert-light border text-center text-muted mt-3 py-4">尚未選擇任何要通知的系所，請點擊上方按鈕新增。</div>`;
            }

            let logHtml = '';
            if (d.logs && d.logs.length > 0) {
            logHtml = `
            <div class="mt-4 pt-3 border-top border-info-subtle">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold text-secondary mb-0"><i class="bi bi-clock-history"></i> 寄送歷程紀錄</h6>
                    <button type="button" class="btn btn-sm btn-outline-primary fw-bold btn-toggle-dispatch-log">📊 顯示詳細歷程</button>
                </div>
                <div class="dispatch-log-container" style="display: none;">
                    <div id="dispatch-logs-grid-${d.id}"></div>
                </div>
            </div>`;
            }

            let signInputHtml = '';
            // 結案時，隱藏尚未簽章的輸入框區塊
            if (!isSent && d.status !== 21 && !isSubmissionClosed) {
            signInputHtml = `
            <div class="d-flex align-items-center bg-white p-3 rounded border shadow-sm mx-0 mb-3 bg-light">
                <span class="fw-bold text-primary me-2"><i class="bi bi-pen"></i> 進行簽核：</span>
                <div class="input-group input-group-sm" style="width: 250px;">
                    <input type="text" class="form-control sign-input" placeholder="請輸入您的姓名">
                    <button class="btn btn-primary btn-sign fw-bold">送出簽章</button>
                </div>
            </div>`;
            }
            
            // 結案時，隱藏刪除按鈕
            const deleteBtnHtml = (isSent || isSubmissionClosed) ? '' : `<button class="btn btn-outline-danger ms-2 fw-bold btn-delete-dispatch"><i class="bi bi-trash"></i> 刪除此單</button>`;
            
            return `
            <div class="card border-info shadow-sm mb-4 dispatch-card" data-id="${d.id}">
                <div class="card-header bg-white border-info-subtle d-flex justify-content-between align-items-center pt-3">
                    <span class="fw-bold text-info fs-5"><i class="bi bi-envelope-paper"></i> 派發單號：${d.id}</span>
                    <div>${primaryActionBtn}${deleteBtnHtml}</div>
                </div>
                <div class="card-body bg-light pb-3">
                    ${signInputHtml}
                    <div class="row bg-white p-3 rounded border shadow-sm mx-0 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted fw-bold"><i class="bi bi-person-badge"></i> 主任簽章</label>
                            ${d.directorSign ? `<div class="fs-5 text-dark fw-bold">${d.directorSign} <span class="fs-6 text-muted ms-2 fw-normal">(${d.directorSignAt})</span></div>` : `<div class="fs-5 text-muted fst-italic">尚未簽核</div>`}
                        </div>
                        <div class="col-md-6 ps-md-4 mt-3 mt-md-0">
                            <label class="form-label small text-muted fw-bold"><i class="bi bi-person-badge"></i> 承辦人簽章</label>
                            ${d.officerSign ? `<div class="fs-5 text-dark fw-bold">${d.officerSign} <span class="fs-6 text-muted ms-2 fw-normal">(${d.officerSignAt})</span></div>` : `<div class="fs-5 text-muted fst-italic">尚未簽核</div>`}
                        </div>
                    </div>
                    ${tableHtml}
                    ${logHtml}
                </div>
            </div>`;
            }

            function initDispatchDataGrids(dispatches) {
            dispatches.forEach(d => {
            // 綁定系所表格
            if (d.selects && d.selects.length > 0) {
            const deptsGrid = new DataGrid({
            containerId: `dispatch-depts-grid-${d.id}`,
            pageSize: 9999,
            columnMapping: {
            deptName: '接收系所',
            contactEmail: '系所信箱',
            status: {
            label: '寄送狀態',
            formatter: (val) => {
            if (val === 20) return '<span class="badge bg-success">✅ 寄送成功</span>';
            if (val === 21) return '<span class="badge bg-danger">❌ 寄送失敗</span>';
            if (val === 10) return '<span class="badge bg-primary">🔄 寄送中</span>';
            return '<span class="badge bg-secondary">⏳ 未寄送</span>';
            }
            }
            }
            });
            deptsGrid.setData(d.selects);
            }

            // 綁定歷程紀錄表格
            if (d.logs && d.logs.length > 0) {
            const sortedLogs = [...d.logs].sort((a, b) => new Date(b.created_at || b.time) - new Date(a.created_at || a.time));
            const logsGrid = new DataGrid({
            containerId: `dispatch-logs-grid-${d.id}`,
            pageSize: 9999,
            columnMapping: {
            time: {
            label: '時間',
            formatter: (_, row) => (row.created_at || row.time || '').replace('T', ' ').substring(0, 19)
            },
            status: {
            label: '結果',
            formatter: (val) => {
            if (val === 20) return '<span class="badge bg-success">成功</span>';
            if (val === 21) return '<span class="badge bg-danger">失敗</span>';
            if (val === 10) return '<span class="badge bg-primary">執行中</span>';
            return '<span class="badge bg-secondary">其他</span>';
            }
            },
            email: {
            label: '目標信箱',
            formatter: (_, row) => row.recipient_email || row.email || '-'
            },
            message: '詳細訊息',
            creator: {
            label: '操作者',
            formatter: (_, row) => row.created_by || row.creator || '-'
            }
            }
            });
            logsGrid.setData(sortedLogs);
            }
            });
            }

            function bindDispatchCardEvents() {
            document.querySelectorAll('.dispatch-card').forEach(card => {
            const dispatchId = card.dataset.id;
                
            const btnDelete = card.querySelector('.btn-delete-dispatch');
            if (btnDelete) {
            btnDelete.addEventListener('click', async () => {
            if (confirm('確定要刪除這張派發單嗎？此動作無法復原。')) {
            try {
            const res = await fetch(`/api/submissions/${currentSubmissionId}/dispatches/${dispatchId}`, { method: 'DELETE' });
            if (!res.ok) throw new Error(await getErrorMessage(res));
            alert('✅ 已刪除');
            await loadDispatchCards();
            } catch (error) { alert(`❌ 刪除失敗：\n${error.message}`); }
            }
            });
            }

            const btnSign = card.querySelector('.btn-sign');
            if (btnSign) {
            btnSign.addEventListener('click', async (e) => {
            const inputEl = card.querySelector('.sign-input');
            const name = inputEl.value.trim();
            if (!name) return alert('⚠️ 請輸入簽章姓名！');
            if (name.length < 2 || name.length > 20) return alert('⚠️ 姓名長度必須介於 2 到 20 個字元之間！');
            try {
            const originalHtml = btnSign.innerHTML;
            btnSign.disabled = true;
            btnSign.innerHTML = '...';
            const res = await fetch(`/api/submissions/${currentSubmissionId}/dispatches/${dispatchId}/sign`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: name })
            });
            if (!res.ok) throw new Error(await getErrorMessage(res));
            alert(`✅ 簽章成功！`);
            await loadDispatchCards();
            } catch (error) {
            alert(`❌ 簽核失敗：\n${error.message}`);
            btnSign.disabled = false;
            btnSign.innerHTML = '送出簽章';
            }
            });
            }

            const btnAddDepts = card.querySelector('.btn-add-depts');
            if (btnAddDepts) {
            btnAddDepts.addEventListener('click', async (e) => {
            e.preventDefault();
            if (btnAddDepts.disabled) return;
            btnAddDepts.disabled = true;
            appState.targetDispatchIdForDepts = dispatchId;
            const modalBody = document.getElementById('deptSelectionModalBody');
            modalBody.innerHTML = '<div class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm"></span> 載入選項中...</div>';
            document.getElementById('deptSearchInput').value = '';
            document.getElementById('selectedDeptCount').textContent = '0';
            const modalEl = document.getElementById('deptSelectionModal');
            deptModalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
            deptModalInstance.show();
            try {
            const res = await fetch('/api/departments/options');
            if (!res.ok) throw new Error(await getErrorMessage(res));
            const depts = await res.json();
            if (depts.length === 0) {
            modalBody.innerHTML = '<div class="alert alert-warning m-3 text-center">系統中目前沒有可用的系所資料。</div>'; return;
            }
            let html = '<div class="row g-2">';
            depts.forEach(d => {
            html += `<div class="col-md-4 col-sm-6 dept-item-container" data-name="${d.name}">
            <label class="form-check-label w-100 h-100" style="cursor: pointer;">
                <input class="form-check-input d-none dept-checkbox" type="checkbox" value="${d.id}">
                <div class="card h-100 dept-card shadow-sm">
                    <div class="card-body p-3 d-flex align-items-center justify-content-between">
                        <span class="dept-name text-secondary fw-semibold">${d.name}</span>
                        <i class="bi bi-check-circle-fill fs-5 text-primary check-icon"></i>
                    </div>
                </div>
            </label>
        </div>`;
        });
        html += '</div>';
        modalBody.innerHTML = html;
        bindDeptModalInteractiveEvents();
        } catch (error) { modalBody.innerHTML = `<div class="alert alert-danger m-3">載入選項失敗：${error.message}</div>`;
        } finally { btnAddDepts.disabled = false; }
        });
        }

        const btnSend = card.querySelector('.btn-send-emails');
        if (btnSend) {
        btnSend.addEventListener('click', async () => {
        const isSigned = btnSend.dataset.signed === 'true';
        if (!isSigned) return alert('⚠️ 無法寄出！必須由「主任」與「承辦人」雙方皆完成簽章後，才可發送通知信。');
        if (confirm('確定要發送通知信給表格中的所有系所嗎？此動作將無法復原。')) {
        const originalHtml = btnSend.innerHTML;
        try {
        btnSend.disabled = true;
        btnSend.innerHTML = '<span class="spinner-border spinner-border-sm"></span> 寄送中...';
        const res = await fetch(`/api/submissions/${currentSubmissionId}/dispatches/${dispatchId}/send`, { method: 'POST' });
        if (!res.ok) throw new Error(await getErrorMessage(res));
        alert('📧 系統已成功發出寄送指令！寄信狀態非即時更新，請自行重新整理頁面。');
        await loadDispatchCards();
        } catch (error) {
        alert(`❌ 寄送失敗：\n${error.message}`);
        btnSend.disabled = false;
        btnSend.innerHTML = originalHtml;
        }
        }
        });
        }

        const btnPreview = card.querySelector('.btn-preview-dispatch');
        if (btnPreview) {
        btnPreview.addEventListener('click', async () => {
        try {
        const originalHtml = btnPreview.innerHTML;
        btnPreview.disabled = true;
        btnPreview.innerHTML = '<span class="spinner-border spinner-border-sm"></span> 載入中...';
        const res = await fetch(`/api/submissions/${currentSubmissionId}/dispatches/${dispatchId}/preview`, { method: 'POST' });
        if (!res.ok) throw new Error(await getErrorMessage(res));
        const blob = await res.blob();
        const blobUrl = window.URL.createObjectURL(new Blob([blob], { type: 'application/pdf' }));
        window.open(blobUrl, '_blank');
        setTimeout(() => { window.URL.revokeObjectURL(blobUrl); }, 1000);
        } catch (error) {
        alert(`❌ 預覽失敗：\n${error.message}`);
        } finally {
        btnPreview.disabled = false;
        btnPreview.innerHTML = '<i class="bi bi-file-earmark-pdf"></i> 預覽附件';
        }
        });
        }

        // 綁定動態顯示/隱藏歷程按鈕
        const btnToggleLog = card.querySelector('.btn-toggle-dispatch-log');
        const logContainer = card.querySelector('.dispatch-log-container');
        if (btnToggleLog && logContainer) {
        btnToggleLog.addEventListener('click', () => {
        const isHidden = logContainer.style.display === 'none';
        logContainer.style.display = isHidden ? 'block' : 'none';
        btnToggleLog.innerHTML = isHidden ? '📊 隱藏詳細歷程' : '📊 顯示詳細歷程';
        btnToggleLog.className = isHidden ? 'btn btn-sm btn-secondary fw-bold btn-toggle-dispatch-log' : 'btn btn-sm btn-outline-primary fw-bold btn-toggle-dispatch-log';
        });
        }
        });
        }

        function bindDeptModalInteractiveEvents() {
        const searchInput = document.getElementById('deptSearchInput');
        const containers = document.querySelectorAll('.dept-item-container');
        const checkboxes = document.querySelectorAll('.dept-checkbox');
        const countSpan = document.getElementById('selectedDeptCount');
        const btnSelectAll = document.getElementById('btn-select-all');
        const btnClearAll = document.getElementById('btn-clear-all');
            
        const updateCount = () => { countSpan.textContent = document.querySelectorAll('.dept-checkbox:checked').length; };
        checkboxes.forEach(cb => cb.addEventListener('change', updateCount));
            
        searchInput.addEventListener('input', (e) => {
        const term = e.target.value.toLowerCase().trim();
        containers.forEach(container => {
        const name = container.dataset.name.toLowerCase();
        container.style.display = name.includes(term) ? '' : 'none';
        });
        });
            
        btnSelectAll.onclick = () => {
        containers.forEach(container => {
        if (container.style.display !== 'none') {
        const cb = container.querySelector('.dept-checkbox');
        if (!cb.checked) cb.checked = true;
        }
        });
        updateCount();
        };
            
        btnClearAll.onclick = () => {
        checkboxes.forEach(cb => cb.checked = false);
        updateCount();
        };
        }

        function bindCloseSubmissionEvent() {
        const btnCloseSubmission = document.getElementById('btn-close-submission');
        if (btnCloseSubmission) {
        btnCloseSubmission.addEventListener('click', async () => {
        if (!confirm('確定要將此通報單結案嗎？結案後將無法再進行操作。')) return;
        btnCloseSubmission.disabled = true;
        const originalHtml = btnCloseSubmission.innerHTML;
        btnCloseSubmission.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> 處理中...';
        try {
        const payload = { Action: 'Approve' };
        const res = await fetch(`/api/submissions/${currentSubmissionId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
        });
        if (res.ok) {
        alert('結案成功！');
        location.reload();
        } else {
        const data = await res.json();
        alert(`操作失敗：${data.error || data.message || '未知錯誤'}`);
        btnCloseSubmission.disabled = false;
        btnCloseSubmission.innerHTML = originalHtml;
        }
        } catch (err) {
        console.error('結案請求錯誤:', err);
        alert('發生網路錯誤，請稍後再試。');
        btnCloseSubmission.disabled = false;
        btnCloseSubmission.innerHTML = originalHtml;
        }
        });
        }
        }
    </text>
}

async function initPage() {
// 所有角色共用的初始化
await fetchInitialData();
renderVersionList();
renderFlowchart();
initHistoryDataGrid();

// 🌟 角色專屬區塊初始化
@if (User.IsInRole(AppRoles.CenterOfficer) || User.IsInRole(AppRoles.CenterDirector))
{
    <text>
        if (appState.status >= 20) {
        const dispatchPanel = document.getElementById('dispatch-management-panel');
        if (dispatchPanel) dispatchPanel.style.display = 'block';
                
        const closeFooter = document.getElementById('close-footer-section');
        if (closeFooter) {
        closeFooter.style.display = (30 > appState.status) ? 'block' : 'none';
        }

        const btnCreateDispatch = document.getElementById('btn-create-dispatch');
        if (btnCreateDispatch) {
        btnCreateDispatch.style.display = (appState.status === 30) ? 'none' : 'inline-block';
        }

        if (typeof initDispatchSection === 'function') initDispatchSection();
        if (typeof bindCloseSubmissionEvent === 'function') bindCloseSubmissionEvent();
        }
    </text>
}

@if (User.IsInRole(AppRoles.DepartmentOfficer) || User.IsInRole(AppRoles.CenterOfficer) || User.IsInRole(AppRoles.CenterDirector))
{
    <text>
        if (typeof bindAuditEvents === 'function') bindAuditEvents();
    </text>
}

if (appState.latestVersionId) {
await fetchAndRenderVersion(appState.latestVersionId);
}
}

// 啟動畫面
initPage();

</script>